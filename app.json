{
  "expo": {
    "name": "Weihnachtsmärkte",
    "slug": "weihnachtsmaerkte-berlin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "weihnachtsmaerkte",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "de.ericeren.weihnachtsmaerkte",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "de",
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Die App nutzt deinen Standort nur auf dem Gerät, um Weihnachtsmärkte in deiner Nähe und Entfernungen anzuzeigen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Die App nutzt deinen Standort nur auf dem Gerät, um Weihnachtsmärkte in deiner Nähe und Entfernungen anzuzeigen."
      }
    },
    "android": {
      "package": "de.ericeren.weihnachtsmaerkte",
      "adaptiveIcon": {
        "backgroundColor": "#1E3B2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Weihnachtsmärkte Berlin",
      "shortName": "Weihnachtsmärkte",
      "lang": "de",
      "themeColor": "#1E3B2C",
      "backgroundColor": "#F5F0E6",
      "description": "Alle Berliner Weihnachtsmärkte der Saison 2026/27 auf einer Karte. Private Übersicht, kein Angebot des Landes Berlin."
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "backgroundColor": "#1E3B2C",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Die App nutzt deinen Standort nur auf dem Gerät, um Weihnachtsmärkte in deiner Nähe und Entfernungen anzuzeigen.",
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d4a13e76-58f8-4927-8ff8-554c2dec542d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d4a13e76-58f8-4927-8ff8-554c2dec542d"
    }
  }
}
